{
  "name": "envio-indexer",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean": "tsc --clean",
    "build": "envio codegen && tsc --build",
    "watch": "tsc --watch",
    "test": "node --import tsx/esm node_modules/mocha/bin/mocha.js test/**/*.ts",
    "codegen": "envio codegen",
    "dev": "envio dev",
    "start": "node build/src/EventHandlers.js"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/mocha": "10.0.6",
    "@types/node": "20.8.8",
    "chai": "4.3.10",
    "mocha": "11.7.6",
    "ts-mocha": "^11.1.0",
    "ts-node": "10.9.2",
    "typescript": "5.2.2"
  },
  "dependencies": {
    "envio": "^3.0.0"
  }
}
